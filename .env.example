# NeonDB (PostgreSQL). В Vercel добавить как Environment Variable.
# Формат: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Для пула (рекомендуется для serverless): ...?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js (OAuth Google) ---
# Сгенерировать: npx auth secret
AUTH_SECRET="ваш-секрет-минимум-32-символа"
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Создать OAuth 2.0 Client ID (тип: Web application), указать redirect: .../api/auth/callback/google
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxx"

# Опционально: рабочая БД для view-db (выбор «Рабочая» в /view-db)
# DATABASE_URL_WORK="postgresql://..."
