# NeonDB (PostgreSQL). В Vercel добавить как Environment Variable.
# Формат: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Для пула (рекомендуется для serverless): ...?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Опционально: рабочая БД для view-db (выбор «Рабочая» в /view-db)
# DATABASE_URL_WORK="postgresql://..."
